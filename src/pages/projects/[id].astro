---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Document from '../../layouts/Document.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, tagline, repo, language, platform, status } = project.data;
---

<Document
  title={`${title} — jvpts11`}
  description={tagline}
  heading={title}
  tagline={tagline}
  crumbs={[
    { href: '/', label: 'jvpts11 OS' },
    { href: '/projects/', label: 'Projects' },
  ]}
>
  <dl class="facts">
    <dt>Repository</dt>
    <dd><a href={repo}>{repo.replace('https://github.com/', '')}</a></dd>
    {language && <dt>Language</dt>}
    {language && <dd>{language}</dd>}
    {platform && <dt>Runs on</dt>}
    {platform && <dd>{platform}</dd>}
    {status && <dt>Status</dt>}
    {status && <dd>{status}</dd>}
    <dt>On the desktop</dt>
    <dd><a href={`/?open=${project.id}`}>Open {title}</a></dd>
  </dl>

  <Content />
</Document>
