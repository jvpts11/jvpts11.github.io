---
import { getCollection } from 'astro:content';
import Document from '../../layouts/Document.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Document
  title="Projects — jvpts11"
  description="Everything jvpts11 builds: Polaron, agents.exe and js-tech-series."
>
  <nav class="page-nav">
    <a href="/">jvpts11 OS</a>
  </nav>

  <h1>Projects</h1>
  <p class="tagline">Everything jvpts11 builds. Each one also opens as a program on the desktop.</p>

  <ul class="project-list">
    {
      projects.map((project) => (
        <li>
          <a href={`/projects/${project.id}/`}>{project.data.title}</a>
          <p>{project.data.tagline}</p>
        </li>
      ))
    }
  </ul>
</Document>
