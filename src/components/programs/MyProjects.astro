---
import { getCollection } from 'astro:content';
import { getProgram } from '../../data/programs';
import { isProgramId } from '../../scripts/wm-core';

// The tiles come from src/content/projects, the same files behind the static
// pages, so the window and the pages can never disagree.
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const tiles = projects.map((project) => ({
  id: project.id,
  title: project.data.title,
  tagline: project.data.tagline,
  page: `/projects/${project.id}/`,
  icon: isProgramId(project.id) ? getProgram(project.id).icon : 'i-folder',
}));
---

<div class="explorer">
  <div class="menubar" aria-hidden="true">
    <span>File</span><span>Edit</span><span>View</span><span>Favorites</span><span>Tools</span><span>Help</span>
  </div>

  <div class="toolbar">
    <button class="tb" type="button" disabled>Back</button>
    <button class="tb" type="button" disabled>Forward</button>
    <span class="sep" aria-hidden="true"></span>
    <button class="tb" type="button" data-launch="computer">
      <svg aria-hidden="true"><use href="#i-computer"></use></svg>Up
    </button>
    <button class="tb" type="button" disabled>Folders</button>
  </div>

  <div class="address">
    <span>Address</span>
    <div class="addr-field">
      <svg aria-hidden="true"><use href="#i-folder"></use></svg>C:\jvpts11\Projects
    </div>
    <button class="btn" type="button" disabled>Go</button>
  </div>

  <div class="ex-main">
    <aside class="taskpane">
      <section class="tp-box">
        <h3>Project Tasks</h3>
        <ul>
          <li><a href="/projects/">Browse the project pages</a></li>
          <li><a href="https://github.com/jvpts11" target="_blank" rel="noopener">View jvpts11 on GitHub</a></li>
        </ul>
      </section>
      <section class="tp-box">
        <h3>Other Places</h3>
        <ul>
          <li><button class="linkbtn" type="button" data-launch="computer">My Computer</button></li>
          <li><button class="linkbtn" type="button" data-launch="recycle-bin">Recycle Bin</button></li>
          <li><button class="linkbtn" type="button" data-launch="contact">Contact</button></li>
        </ul>
      </section>
      <section class="tp-box">
        <h3>Details</h3>
        <div class="details" data-details>
          <strong>Projects</strong>
          <span>{tiles.length} items. Select one to see details.</span>
        </div>
      </section>
    </aside>

    <div class="ex-view">
      <ul class="tiles" aria-label="Projects">
        {
          tiles.map((tile) => (
            <li>
              <button
                class="tile"
                type="button"
                data-program={tile.id}
                data-name={tile.title}
                data-desc={tile.tagline}
                data-page={tile.page}
              >
                <svg aria-hidden="true">
                  <use href={`#${tile.icon}`} />
                </svg>
                <span>
                  <strong>{tile.title}</strong>
                  <span>{tile.tagline}</span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>
