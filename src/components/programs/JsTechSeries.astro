---
// The description is the owner's own repository description, reused verbatim.
const REPO = 'https://github.com/jvpts11/js-tech-series';
const DESCRIPTION =
  'Computers that run the logistics of your Minecraft base: build the hardware, install a system, and let the network store, move and craft. Minecraft 1.21.1, NeoForge.';
---

<div class="about jts">
  <div class="about-banner">
    <svg aria-hidden="true"><use href="#i-jts"></use></svg>js-tech-series
  </div>
  <div class="about-body">
    <h3 class="about-title">js-tech-series</h3>
    <p class="lead">{DESCRIPTION}</p>

    <ul class="chips">
      <li><svg aria-hidden="true"><use href="#i-computer"></use></svg>Computers</li>
      <li><svg aria-hidden="true"><use href="#i-net"></use></svg>Networks</li>
      <li><svg aria-hidden="true"><use href="#i-folder"></use></svg>SQL-like logistics</li>
    </ul>

    <p class="todo">TODO(jvpts11): screenshots of the mod in game.</p>

    <div class="dlg-actions">
      <a class="btn" href={REPO} target="_blank" rel="noopener">Open on GitHub</a>
      <button class="btn" type="button" data-close>Close</button>
    </div>
  </div>
</div>
