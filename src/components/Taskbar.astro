---
// The bar at the bottom: start button, one button per open window and the
// notification tray with the clock. Task buttons are added by wm.ts.
---

<footer class="taskbar">
  <button class="start" id="startbtn" type="button" aria-expanded="false" aria-controls="startmenu">
    <svg aria-hidden="true"><use href="#i-start"></use></svg>start
  </button>
  <div class="tasks" id="tasks" role="toolbar" aria-label="Open windows"></div>
  <div class="tray">
    <svg class="net" role="img" aria-label="Network"><use href="#i-net"></use></svg>
    <svg class="vol" role="img" aria-label="Volume"><use href="#i-vol"></use></svg>
    <span class="clock" id="clock">--:--</span>
  </div>
</footer>
