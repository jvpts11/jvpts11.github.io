---
// Tray notification shown on arrival. Dismissible, and it never comes back
// in the same visit.
---

<div class="balloon" id="balloon" role="status">
  <h2>
    <svg aria-hidden="true"><use href="#i-info"></use></svg>Welcome to jvpts11 OS
  </h2>
  <p>
    Double-click an icon or use <b>start</b> to open a program. Every project also has a page of its
    own and a link to its repository.
  </p>
  <button class="x" id="balloon-x" type="button" aria-label="Dismiss notification">✕</button>
</div>
